# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 허용된 텔레그램 유저 ID (보안용, 쉼표 구분)
ALLOWED_USER_IDS=123456789

# Korail (KTX) 계정
KORAIL_ID=your_korail_id
KORAIL_PW=your_korail_password

# SRT 계정
SRT_ID=your_srt_id
SRT_PW=your_srt_password

# 결제 카드 정보 (자동결제 시 사용)
# Korail: 등록된 카드 번호 앞 4자리 또는 카드 별칭
KORAIL_CARD_NUMBER=
KORAIL_CARD_EXPIRY=
KORAIL_CARD_BIRTH=

# SRT: 등록된 카드 번호
SRT_CARD_NUMBER=
SRT_CARD_EXPIRY=
SRT_CARD_BIRTH=

# 취소표 모니터링 간격 (초, 기본 30)
WATCH_INTERVAL=30
